rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // 1. Users Collection
    // =========================================================
    match /users/{userId} {
      // Anyone can view user profile
      allow read: if true;
      // Allow user creation & profile updates for all network members (Google & Zalo & Direct)
      allow create, update: if true;
      allow delete: if false;
    }

    // =========================================================
    // 2. Opportunities Collection
    // =========================================================
    match /opportunities/{opportunityId} {
      // Public read for exploring opportunities
      allow read: if true;
      // Allow members to create, edit or delete opportunities
      allow create, update, delete: if true;
    }

    // =========================================================
    // 3. Invitations Collection
    // =========================================================
    match /invitations/{invitationId} {
      // Allow reading and managing connection invitations
      allow read, write: if true;
    }

    // =========================================================
    // 4. Conversations Collection & Messages Subcollection
    // =========================================================
    match /conversations/{conversationId} {
      // Allow member conversations
      allow read, write: if true;

      // Messages subcollection
      match /messages/{messageId} {
        allow read, create: if true;
        allow update: if false;
        allow delete: if true;
      }
    }

    // =========================================================
    // 5. Industry Insights Collection
    // =========================================================
    match /industry_insights/{insightId} {
      // Anyone can read and update market intelligence and industry news
      allow read, write: if true;
    }

    // =========================================================
    // 6. Business Contacts (Rolodex) Collection
    // =========================================================
    match /business_contacts/{contactId} {
      // Allow authenticated user to manage their business rolodex contacts
      allow read, write: if true;
    }

    // =========================================================
    // 7. Business Digital Cards Collection
    // =========================================================
    match /business_cards/{cardId} {
      // Public read for scanning QR and opening digital card
      allow read: if true;
      // Allow owner to update card details
      allow write: if true;
    }

  }
}
