{
  "entities": {
    "User": {
      "collection": "users",
      "fields": {
        "id": { "type": "string", "description": "UID người dùng (Firebase Auth hoặc Zalo ID)" },
        "displayName": { "type": "string", "description": "Tên người dùng" },
        "email": { "type": "string", "description": "Email người dùng" },
        "photoURL": { "type": "string", "description": "Ảnh đại diện" },
        "phoneNumber": { "type": "string", "description": "Số điện thoại liên hệ" },
        "bio": { "type": "string", "description": "Giới thiệu ngắn" },
        "role": { "type": "string", "description": "Vai trò (vd: user, partner, mentor)" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật" }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "false"
      }
    },
    "Opportunity": {
      "collection": "opportunities",
      "fields": {
        "id": { "type": "string", "description": "ID cơ hội" },
        "ownerId": { "type": "string", "description": "UID của người tạo cơ hội" },
        "ownerName": { "type": "string", "description": "Tên người tạo" },
        "ownerAvatar": { "type": "string", "description": "Ảnh đại diện người tạo" },
        "title": { "type": "string", "description": "Tiêu đề cơ hội / nhu cầu" },
        "category": { "type": "string", "description": "Danh mục (project, resource, space, partner)" },
        "description": { "type": "string", "description": "Mô tả chi tiết" },
        "location": { "type": "string", "description": "Địa điểm / Khu vực" },
        "scale": { "type": "string", "description": "Quy mô nhân sự / đối tác" },
        "reward": { "type": "string", "description": "Ngân sách / Chia sẻ quyền lợi" },
        "status": { "type": "string", "description": "Trạng thái (active, closed, paused)" },
        "createdAt": { "type": "string", "description": "Thời gian đăng" },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật" }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    "Invitation": {
      "collection": "invitations",
      "fields": {
        "id": { "type": "string", "description": "ID lời mời kết nối" },
        "senderId": { "type": "string", "description": "UID người gửi lời mời" },
        "senderName": { "type": "string", "description": "Tên người gửi" },
        "receiverId": { "type": "string", "description": "UID người nhận lời mời" },
        "opportunityId": { "type": "string", "description": "ID cơ hội liên kết" },
        "opportunityTitle": { "type": "string", "description": "Tiêu đề cơ hội" },
        "message": { "type": "string", "description": "Tin nhắn kèm theo" },
        "status": { "type": "string", "description": "Trạng thái (pending, accepted, rejected)" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật" }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    "Conversation": {
      "collection": "conversations",
      "fields": {
        "id": { "type": "string", "description": "ID cuộc hội thoại" },
        "participantIds": { "type": "array", "description": "Danh sách UID thành viên tham gia" },
        "participantNames": { "type": "map", "description": "Tên các thành viên" },
        "lastMessage": { "type": "string", "description": "Nội dung tin nhắn cuối" },
        "lastMessageSenderId": { "type": "string", "description": "UID người gửi cuối" },
        "lastMessageAt": { "type": "string", "description": "Thời gian tin nhắn cuối" },
        "createdAt": { "type": "string", "description": "Thời gian tạo cuộc trò chuyện" },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật" }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "false"
      },
      "subcollections": {
        "messages": {
          "fields": {
            "id": { "type": "string", "description": "ID tin nhắn" },
            "senderId": { "type": "string", "description": "UID người gửi" },
            "senderName": { "type": "string", "description": "Tên người gửi" },
            "content": { "type": "string", "description": "Nội dung tin nhắn" },
            "timestamp": { "type": "string", "description": "Thời gian gửi" }
          },
          "rules": {
            "read": "true",
            "create": "true",
            "update": "false",
            "delete": "true"
          }
        }
      }
    },
    "IndustryInsight": {
      "collection": "industry_insights",
      "fields": {
        "id": { "type": "string", "description": "ID bản tin thị trường" },
        "title": { "type": "string", "description": "Tiêu đề bản tin" },
        "category": { "type": "string", "description": "Lĩnh vực: supply_chain, policy_tax, funding_market, case_study, tech_ai" },
        "categoryLabel": { "type": "string", "description": "Nhãn danh mục tiếng Việt" },
        "summary": { "type": "string", "description": "Tóm tắt cốt lõi 1 câu" },
        "keyTakeaways": { "type": "array", "description": "3 ý đúc kết then chốt" },
        "actionableOpportunity": { "type": "string", "description": "Cơ hội hành động cho doanh nghiệp" },
        "source": { "type": "string", "description": "Nguồn thông tin kiểm chứng" },
        "imageUrl": { "type": "string", "description": "Ảnh minh họa" },
        "publishedAt": { "type": "string", "description": "Thời gian đăng tải" },
        "createdAt": { "type": "string", "description": "Thời gian tạo" }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    },
    "BusinessContact": {
      "collection": "business_contacts",
      "fields": {
        "id": { "type": "string", "description": "ID liên hệ đối tác" },
        "userId": { "type": "string", "description": "UID người sở hữu danh bạ" },
        "contactName": { "type": "string", "description": "Họ và tên đối tác" },
        "company": { "type": "string", "description": "Tên doanh nghiệp / công ty" },
        "position": { "type": "string", "description": "Chức vụ" },
        "phone": { "type": "string", "description": "Số điện thoại liên hệ" },
        "zaloPhone": { "type": "string", "description": "Số Zalo liên hệ" },
        "email": { "type": "string", "description": "Email" },
        "industry": { "type": "string", "description": "Ngành nghề kinh doanh" },
        "location": { "type": "string", "description": "Địa điểm / tỉnh thành" },
        "tags": { "type": "array", "description": "Nhãn phân loại (Hội chợ, Cung ứng, Khách hàng...)" },
        "coreStrengths": { "type": "string", "description": "Thế mạnh cốt lõi & năng lực cung cấp" },
        "needs": { "type": "string", "description": "Nhu cầu cần hợp tác" },
        "meetingContext": { "type": "string", "description": "Ngữ cảnh gặp gỡ" },
        "createdAt": { "type": "string", "description": "Thời gian lưu" },
        "updatedAt": { "type": "string", "description": "Thời gian cập nhật" }
      },
      "rules": {
        "read": "true",
        "create": "true",
        "update": "true",
        "delete": "true"
      }
    }
  }
}
